<?xml version="1.0" encoding="UTF-8"?>
<!-- Postus behind Configuration, which sets the internal output of log4j2, which can be set without setting, and when set to track, you see the detailed output of log4j2. -->
<!-- Monitor Interval: Log4j can automatically detect changes to the configuration file and reconfigure itself, setting the number of seconds between -->
<configuration status="WARN" monitorInterval="30">

    <Properties>
        <!-- LOG HOME: Docker environments have to set absolute paths through -DLOG HOME properties, otherwise use relative paths logs -->
        <Property name="LOG_HOME">${sys:LOG_HOME:-logs}</Property>
        <!-- Log Output Format -->
        <property name="LOG_PATTERN" value="%d{HH:mm:ss:SSS} [%thread] [%p] - %c{1.} %M:%L - %m%n" />
    </Properties>

    <!-- Define all applications first -->
    <appenders>

        <!-- The configuration of this output console -->
        <console name="Console" target="SYSTEM_OUT">
            <!-- Output log format -->
            <PatternLayout pattern="${LOG_PATTERN}"/>
        </console>

        <!-- This output to the configuration of the file will print all info and below-level information, each time size exceeds size, the size log will automatically be placed and compressed under the year-month folder to be archived -->
        <!-- Info Log -->
        <RollingFile name="RollingFileInfo" fileName="${LOG_HOME}/info.log"
                     filePattern="${LOG_HOME}/$${date:yyyy-MM}/info-%d{yyyy-MM-dd}-%i.log">
            <!-- Console only output information (onMatch) on level and above, other direct rejections (onMismatch) -->
            <ThresholdFilter level="info" onMatch="ACCEPT" onMismatch="DENY"/>
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="128 MB"/>
            </Policies>
            <!-- If the Default RolloverStrategy properties are not set, the default is up to seven files in the same folder, set to 24 -->
            <DefaultRolloverStrategy max="24"/>
        </RollingFile>

        <!-- Warn Log -->
        <RollingFile name="RollingFileWarn" fileName="${LOG_HOME}/warn.log"
                     filePattern="${LOG_HOME}/$${date:yyyy-MM}/warn-%d{yyyy-MM-dd}-%i.log">
            <ThresholdFilter level="warn" onMatch="ACCEPT" onMismatch="DENY"/>
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="64 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="24"/>
        </RollingFile>

        <!-- Error Log -->
        <RollingFile name="RollingFileError" fileName="${LOG_HOME}/error.log"
                     filePattern="${LOG_HOME}/$${date:yyyy-MM}/error-%d{yyyy-MM-dd}-%i.log">
            <ThresholdFilter level="error" onMatch="ACCEPT" onMismatch="DENY"/>
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="64 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="24"/>
        </RollingFile>

    </appenders>

    <!-- Then define the logger, which will only take effect if the logger is defined and introduced into the application. -->
    <loggers>
        <!-- Log output level, 8 levels, from low to high: All < Trace < Debug < Info < Warn < Error < Fatal < OFF. -->
        <root level="Info">
            <appender-ref ref="Console"/>
            <appender-ref ref="RollingFileInfo"/>
            <appender-ref ref="RollingFileWarn"/>
            <appender-ref ref="RollingFileError"/>
        </root>
    </loggers>

</configuration>